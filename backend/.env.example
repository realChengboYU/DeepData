# ===== LLM（OpenAI 兼容接口，纯对话智能体）=====
# 模型 id（示例值，请替换为你自己的模型 id）
LLM_MODEL=<your-model-id>
LLM_MODEL_ID=<your-model-id>
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=sk-xxxxxxxx

# ===== LangSmith 追踪（不配置则不开启上报）=====
# LANGSMITH_API_KEY=lsv2-xxxxxxxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=AskData_Agent

# ===== 数据源（PostgreSQL，智能体 SQL 工具所连的业务库）=====
# 只写占位符；把你的真实连接串写入本地 .env（已被 .gitignore 忽略，不会提交）。
PG_CONNECTION_STRING=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB

# ===== 字段级 Schema 检索：Embedding（OpenAI 兼容 /v1/embeddings）=====
# 未配置 EMBED_HOST 时，Schema_Retrival 回退到本地 Hash Embedding（跑通流程用）。
EMBED_MODEL=qwen3-embedding
EMBED_DIMENSIONS=2560
EMBED_HOST=http://172.168.100.146:4651/v1
# EMBED_API_KEY=
# EMBED_TIMEOUT=90
# EMBED_BATCH_SIZE=32
# 部分模型（如 qwen3-embedding）不支持 Matryoshka，带 dimensions 会 400；默认 0 不发送。
# EMBED_SEND_DIMENSIONS=0

# ===== 记忆存储（PostgreSQL，本地 Docker：docker compose up -d）=====
DATABASE_URL=postgresql://askdata:askdata@localhost:5432/askdata_memory

# ===== 后端 =====
# ASK_DATA_SECRET=change-me-in-prod

# ===== 数据源凭据加密密钥（AES-GCM，32 字节 base64）=====
# 生成：python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 不配置则回退开发默认密钥（会有告警）；生产务必配置，且数据落库后勿更换。
# DS_CREDENTIAL_KEY=<your-32-byte-base64-key>
